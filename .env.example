# Copie para .env (o .env nunca vai para o git). Todas as variáveis são opcionais.

# Servidor (só escuta em 127.0.0.1: é uma ferramenta local, sem login)
PORT=4300
DATA_DIR=./data

# Modelo aberto local (Ollama). O motor de decisão usa as probabilidades do próximo
# token (método LLM2Jev, arXiv 2610.02076) e precisa de um modelo da família Qwen (ChatML).
OLLAMA_URL=http://127.0.0.1:11434
DECIDE_MODEL=qwen3:1.7b
# "qwen3" pula o bloco <think>; use "chatml" para Qwen2.5
DECIDE_TEMPLATE=qwen3
WRITE_MODEL=qwen3:1.7b

# Opcional e PAGO: o Jev real da TypeSafe pelo OpenRouter (não é open source).
# DECIDE_BACKEND=jev
# OPENROUTER_API_KEY=

# WhatsApp via OpenWA (https://github.com/rmyndharis/OpenWA, MIT), rodando no seu PC.
# Sem estas três, nada é enviado: as mensagens aprovadas ficam com o botão wa.me.
OPENWA_URL=http://127.0.0.1:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Token que o OpenWA manda de volta na URL do webhook (gere um aleatório)
WEBHOOK_TOKEN=

# Python com Playwright para a fonte Google Maps
PYTHON=python

# senha do acesso remoto pelo celular (túnel). Vazio = só o próprio PC.
ACESSO_SENHA=

# senha de quem só assiste pelo túnel (somente leitura, telefones mascarados; 8+ caracteres)
ESPECTADOR_SENHA=
